#!/bin/bash
# AI Director.app launcher. Starts the control server and opens the browser.
# Quitting this app (Cmd-Q from the Dock) stops the VLM and speech backends.

SELF="${BASH_SOURCE[0]}"
DIR="$(cd "$(dirname "$SELF")/../../.." 2>/dev/null && pwd)"
if [ ! -f "$DIR/launcher/control_server.py" ]; then
  DIR="/Users/eugenionerelli/dev/UV/aidirector/smolvlm-audio-transcription"
fi
cd "$DIR" || exit 1

PY="$DIR/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"

# If the control server is already running, just open the browser and exit.
if /usr/bin/nc -z 127.0.0.1 8000 2>/dev/null; then
  /usr/bin/open "http://127.0.0.1:8000"
  exit 0
fi

# Ensure a Vosk speech model exists (small 40 MB model preferred).
if [ ! -d "$DIR/models/vosk-model-small-en-us-0.15" ] && [ ! -d "$DIR/models/vosk-model-en-us-0.42-gigaspeech" ]; then
  /usr/bin/curl -L https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip -o /tmp/vosk-small.zip \
    && /usr/bin/unzip -q /tmp/vosk-small.zip -d "$DIR/models/" \
    && /bin/rm -f /tmp/vosk-small.zip
fi

# Open the browser once the control server is listening.
( for i in $(seq 1 80); do /usr/bin/nc -z 127.0.0.1 8000 2>/dev/null && break; sleep 0.25; done; /usr/bin/open "http://127.0.0.1:8000" ) &

exec "$PY" "$DIR/launcher/control_server.py"
